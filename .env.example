# Postgres connection string from the Neon dashboard
# (Connection Details > Pooled connection string is recommended for serverless)
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb"

# Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# --- Email ---------------------------------------------------------------
# Two transports are supported; if both are set, Gmail wins.
#
# Gmail SMTP — sends from your own Gmail address, so it reaches any recipient
# without owning a domain. Requires 2-Step Verification, then an App Password
# from https://myaccount.google.com/apppasswords (the app password is 16
# characters, shown once, spaces are optional).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Resend — turns real sending on without Gmail. Needs EMAIL_FROM on a verified
# domain to reach anyone but the Resend account's own address.
RESEND_API_KEY=

# The From address. With Gmail it must be your GMAIL_USER (anything else is
# ignored, since Gmail can only send as the authenticated address). With
# Resend it falls back to RentBase-PH <onboarding@resend.dev>.
EMAIL_FROM=

#Builds the links inside emails (portal link, reset link). Right now these point at localhost
AUTH_URL=

# --- Google sign-in (optional) -------------------------------------------
# Adds a "Continue with Google" option to /login, /register, and the tenant
# invite page (/portal-setup, so an invited tenant can skip the password).
# Create an
# OAuth 2.0 Client ID of type "Web application" at
# https://console.cloud.google.com/apis/credentials and add the authorized
# redirect URI <AUTH_URL>/api/auth/callback/google for every origin you use
# (http://localhost:3000 locally, plus your deployment URL). Leave both blank
# to hide the option — email and password keep working either way.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Rent payments (GCash + bank transfer) are manual send-money flows: tenants
# pay from their own GCash or bank app and submit a reference number the
# landlord verifies. No gateway keys are needed — the landlord saves their
# GCash wallet and bank accounts under Settings.

#Vercel authenticates the daily cron job with it
CRON_SECRET=
