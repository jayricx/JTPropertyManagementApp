# Postgres connection string from the Neon dashboard
# (Connection Details > Pooled connection string is recommended for serverless)
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb"

# Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# --- Email ---------------------------------------------------------------
# Two transports are supported; if both are set, Gmail wins.
#
# Gmail SMTP — sends from your own Gmail address, so it reaches any recipient
# without owning a domain. Requires 2-Step Verification, then an App Password
# from https://myaccount.google.com/apppasswords (the app password is 16
# characters, shown once, spaces are optional).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Resend — turns real sending on without Gmail. Needs EMAIL_FROM on a verified
# domain to reach anyone but the Resend account's own address.
RESEND_API_KEY=

# The From address. With Gmail it must be your GMAIL_USER (anything else is
# ignored, since Gmail can only send as the authenticated address). With
# Resend it falls back to JT Property Management <onboarding@resend.dev>.
EMAIL_FROM=

#Builds the links inside emails (portal link, reset link). Right now these point at localhost
AUTH_URL=

# --- Card payments (optional) --------------------------------------------
# Tenants can pay rent by credit/debit card on PayMongo's hosted page. Create
# an account at https://paymongo.com, then paste the Secret Key (starts with
# sk_, from Developers > API Keys). Leave blank to hide card checkout — the
# manual GCash flow is unaffected.
PAYMONGO_SECRET_KEY=

# The signing secret from the webhook you register at
# Developers > Webhooks, pointing at <AUTH_URL>/api/payments/paymongo/webhook
# with the `checkout_session.payment.paid` event. Without it, PayMongo events
# are rejected and card payments won't record on their own.
PAYMONGO_WEBHOOK_SECRET=

#Vercel authenticates the daily cron job with it
CRON_SECRET=
